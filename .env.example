# Copiado para .env por `make setup` (senhas geradas). Nunca versionar o .env real.
NEMEC_DB_PORT=5433
NEMEC_POSTGRES_PASSWORD=__GERAR__
NEMEC_APP_PASSWORD=__GERAR__
# Aplicação (papel nemec_app) e migrações (superusuário do contêiner + SET ROLE nemec_owner)
NEMEC_DATABASE_URL=postgresql://nemec_app:__NEMEC_APP_PASSWORD__@127.0.0.1:__NEMEC_DB_PORT__/nemec
NEMEC_ADMIN_URL=postgresql://postgres:__NEMEC_POSTGRES_PASSWORD__@127.0.0.1:__NEMEC_DB_PORT__/nemec
# Ollama (apenas localhost) e modelo de chat (configurável)
NEMEC_OLLAMA_HOST=http://127.0.0.1:11434
NEMEC_CHAT_MODEL=qwen3.5:9b
NEMEC_EMBED_MODEL=bge-m3
